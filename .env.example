# Recommended: Cloudflare Worker -> Resend API. RESEND_API_KEY must be a Cloudflare secret.
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@your-verified-domain.example
EMAIL_REPLY_TO=your-team@gmail.com
LEAD_NOTIFICATION_RECIPIENTS=lead-owner-1@example.com,lead-owner-2@example.com
RESEND_API_KEY=re_replace_with_cloudflare_secret

# Alternative: send directly through a Google Workspace / Gmail account.
# Set EMAIL_PROVIDER=gmail and store all credentials below as Cloudflare secrets.
GMAIL_CLIENT_ID=replace_with_google_oauth_client_id
GMAIL_CLIENT_SECRET=replace_with_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=replace_with_google_oauth_refresh_token
GMAIL_FROM=your-team@gmail.com
